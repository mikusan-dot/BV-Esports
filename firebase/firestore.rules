rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountRole;
    }

    function isOwner() {
      return isAuthenticated() && getUserRole() == 'Owner';
    }

    function isAdmin() {
      return isAuthenticated() && (getUserRole() == 'Owner' || getUserRole() == 'Admin');
    }

    function isManagerOrAbove() {
      return isAuthenticated() && (
        getUserRole() == 'Owner' || getUserRole() == 'Admin' || getUserRole() == 'Manager'
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if false; // Only server can create users
      allow update: if isOwner() || (isAuthenticated() && request.auth.uid == userId);
      allow delete: if isOwner();
    }

    // Players collection
    match /players/{playerId} {
      allow read: if isAuthenticated();
      allow create: if isManagerOrAbove();
      allow update: if isManagerOrAbove();
      allow delete: if isAdmin();
    }

    // Transactions collection
    match /transactions/{transactionId} {
      allow read: if isManagerOrAbove();
      allow create: if isManagerOrAbove();
      allow update: if isManagerOrAbove();
      allow delete: if isManagerOrAbove();
    }

    // Announcements collection
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create: if isManagerOrAbove();
      allow update: if isManagerOrAbove();
      allow delete: if isAdmin();
    }

    // Activity logs
    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow create: if false; // Only server creates logs
      allow update: if false;
      allow delete: if isOwner();
    }

    // Team settings
    match /team/{document} {
      allow read: if isAuthenticated();
      allow write: if isOwner();
    }
  }
}
